<Window x:Class="QraConfig.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Style="{StaticResource {x:Type Window}}" Title="QRA-Config" Icon="/Assets/qra-config.png" Width="900" Height="805" MinWidth="720" MinHeight="640" WindowStartupLocation="CenterScreen" Loaded="Window_Loaded" Closing="Window_Closing" PreviewKeyDown="Window_PreviewKeyDown" PreviewMouseDown="Window_PreviewPointerDown" PreviewTouchDown="Window_PreviewPointerDown" PreviewStylusDown="Window_PreviewPointerDown" UseLayoutRounding="True">
 <Grid Margin="16,14">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Grid.Row="0" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal"><Image Source="/Assets/qra-config.png" Width="32" Height="32" Margin="0,0,10,0"/><StackPanel><TextBlock Text="QRA-Config" Foreground="{StaticResource AmberBrush}" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="Настройки QRA-Talk через USB" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,3,0,0"/></StackPanel></StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="Справка" Click="Guide_Click" Margin="0,0,10,0"/><Button Content="Помощь с USB" Click="Help_Click"/></StackPanel>
  </Grid>
  <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" CornerRadius="8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,0,12">
   <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="3"/></Grid.RowDefinitions>
    <Grid Margin="12,10,12,8"><Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource AmberBrush}" VerticalAlignment="Center" HorizontalAlignment="Left"/><TextBlock x:Name="StatusText" Grid.Column="1" Text="Подключите Android-устройство к компьютеру по USB." VerticalAlignment="Center" TextWrapping="Wrap"/></Grid>
    <Grid Grid.Row="1" Margin="12,0,12,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="DevicePicker" SelectionChanged="Device_Changed" AutomationProperties.Name="Android-устройство"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><Button x:Name="RefreshButton" Grid.Column="1" Content="Обновить" Margin="10,0,0,0" Click="Refresh_Click"/><Button x:Name="ConnectButton" Grid.Column="2" Content="Подключить" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" IsEnabled="False" Click="Connect_Click"/></Grid>
    <StackPanel Grid.Row="2" Margin="12,0,12,10">
     <CheckBox x:Name="InstallBeforeConnect" Content="Установить QRA-Talk перед настройкой" Checked="InstallOption_Changed" Unchecked="InstallOption_Changed"/>
     <StackPanel Margin="0,4,0,0"><TextBlock Text="Источник и установка APK" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,6"/>
     <Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <ComboBox x:Name="ApkSource" SelectedIndex="0" SelectionChanged="ApkSource_Changed" AutomationProperties.Name="Источник APK"><ComboBoxItem Content="Последний релиз QRA-Talk · Global"/><ComboBoxItem Content="Последний релиз QRA-Talk · terminal_mode"/><ComboBoxItem Content="Локальный APK"/></ComboBox>
      <Button x:Name="BrowseApkButton" Grid.Column="1" Content="Выбрать APK…" Margin="10,0,0,0" Click="BrowseApk_Click" IsEnabled="False"/>
      <Button x:Name="InstallApkButton" Grid.Column="2" Content="Только установить" Margin="10,0,0,0" Click="InstallApk_Click" IsEnabled="False"/>
     </Grid>
     <TextBlock x:Name="ApkFileText" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" Text="Обновление сохраняет данные. Для настройки нужен QRA-Talk с поддержкой USB."/>
     </StackPanel>
    </StackPanel>
    <ProgressBar x:Name="BusyProgress" Grid.Row="3" Height="3" IsIndeterminate="True" Visibility="Hidden" Foreground="{StaticResource AmberBrush}" Background="Transparent" BorderThickness="0"/>
   </Grid>
  </Border>
  <Grid Grid.Row="2" x:Name="SettingsNavigationHost" ClipToBounds="True" SizeChanged="SettingsNavigationHost_SizeChanged">
   <Grid x:Name="NavigationPanels" Background="{StaticResource BackgroundBrush}">
    <Grid.RenderTransform><TranslateTransform x:Name="NavigationTranslate"/></Grid.RenderTransform>
    <Grid.ColumnDefinitions><ColumnDefinition x:Name="MasterColumn" Width="280"/><ColumnDefinition Width="1"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Grid x:Name="MasterNavigationColumn" Grid.Column="0" Margin="0,0,8,0" Background="Transparent"><Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <TextBlock x:Name="MasterRootHeader" Text="Настройки" FontSize="18" FontWeight="SemiBold" Margin="12,0,12,4" VerticalAlignment="Bottom" Focusable="False" AutomationProperties.Name="Настройки" AutomationProperties.HeadingLevel="Level2"/>
     <Button x:Name="MasterBackButton" Style="{StaticResource NavigationHeaderButton}" Click="MasterBack_Click" Visibility="Collapsed" AutomationProperties.Name="Назад"><StackPanel Orientation="Horizontal"><TextBlock Text="←" FontSize="24" VerticalAlignment="Center" Margin="0,0,16,0"/><TextBlock x:Name="MasterHeaderText" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></StackPanel></Button>
     <Grid Grid.Row="1"><ScrollViewer x:Name="MasterMenuScroll" Style="{StaticResource HiddenMenuScrollViewer}" ScrollChanged="MenuScroll_ScrollChanged" GotKeyboardFocus="MenuScroll_GotKeyboardFocus"><StackPanel x:Name="MasterMenuPanel" Margin="12,4,12,4"/></ScrollViewer><Border x:Name="MasterTopFade" Height="24" VerticalAlignment="Top" IsHitTestVisible="False" Visibility="Collapsed"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#FF101215" Offset="0"/><GradientStop Color="#00101215" Offset="1"/></LinearGradientBrush></Border.Background></Border><Border x:Name="MasterBottomFade" Height="24" VerticalAlignment="Bottom" IsHitTestVisible="False" Visibility="Collapsed"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00101215" Offset="0"/><GradientStop Color="#FF101215" Offset="1"/></LinearGradientBrush></Border.Background></Border></Grid>
    </Grid>
    <Border x:Name="NavigationDivider" Grid.Column="1" Background="{StaticResource BorderBrush}" VerticalAlignment="Stretch"/>
    <Grid x:Name="DetailNavigationColumn" Grid.Column="2" Margin="8,0,0,0" Background="Transparent"><Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Button x:Name="DetailBackButton" Style="{StaticResource NavigationHeaderButton}" Click="DetailBack_Click" Visibility="Collapsed" AutomationProperties.Name="Назад"><StackPanel Orientation="Horizontal"><TextBlock Text="←" FontSize="24" VerticalAlignment="Center" Margin="0,0,16,0"/><TextBlock x:Name="DetailHeaderText" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></StackPanel></Button>
     <Grid Grid.Row="1">
      <TextBlock x:Name="EmptyDetailHint" Text="Выберите раздел" Foreground="{StaticResource MutedBrush}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      <ScrollViewer x:Name="DetailMenuScroll" Style="{StaticResource HiddenMenuScrollViewer}" Visibility="Collapsed" ScrollChanged="MenuScroll_ScrollChanged" GotKeyboardFocus="MenuScroll_GotKeyboardFocus"><StackPanel x:Name="DetailMenuPanel" Margin="12,4,12,4"/></ScrollViewer>
      <ScrollViewer x:Name="EditorScroll" Style="{StaticResource HiddenMenuScrollViewer}" Visibility="Collapsed" ScrollChanged="MenuScroll_ScrollChanged" GotKeyboardFocus="MenuScroll_GotKeyboardFocus"><StackPanel x:Name="EditorPanel" Margin="12,4,12,8"/></ScrollViewer>
      <Border x:Name="DetailTopFade" Height="24" VerticalAlignment="Top" IsHitTestVisible="False" Visibility="Collapsed"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#FF101215" Offset="0"/><GradientStop Color="#00101215" Offset="1"/></LinearGradientBrush></Border.Background></Border>
      <Border x:Name="DetailBottomFade" Height="24" VerticalAlignment="Bottom" IsHitTestVisible="False" Visibility="Collapsed"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00101215" Offset="0"/><GradientStop Color="#FF101215" Offset="1"/></LinearGradientBrush></Border.Background></Border>
     </Grid>
    </Grid>
   </Grid>
  </Grid>
  <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="12" Margin="0,10,0,0">
   <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><WrapPanel x:Name="ScopePanel" Grid.Row="0" Margin="0,0,0,6"><TextBlock Text="Применить:" VerticalAlignment="Center" Margin="0,0,16,0"/><CheckBox Content="Общие" Tag="COMMON" IsChecked="True" Checked="Scope_Changed" Unchecked="Scope_Changed"/><CheckBox Content="FRN" Tag="FRN" IsChecked="True" Checked="Scope_Changed" Unchecked="Scope_Changed"/><CheckBox Content="DMR" Tag="DMR" IsChecked="True" Checked="Scope_Changed" Unchecked="Scope_Changed"/><CheckBox Content="P25" Tag="P25" IsChecked="True" Checked="Scope_Changed" Unchecked="Scope_Changed"/><CheckBox Content="PoC" Tag="POC" IsChecked="True" Checked="Scope_Changed" Unchecked="Scope_Changed"/><Button Content="Выбрать все" MinHeight="30" Padding="8,4" Margin="4,0,0,0" Click="SelectAll_Click"/><Button Content="Снять все" MinHeight="30" Padding="8,4" Margin="6,0,0,0" Click="DeselectAll_Click"/></WrapPanel>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center" Margin="0,0,12,0"><TextBlock x:Name="DirtyText" Text="Настройки ещё не прочитаны." FontWeight="Medium"/><TextBlock Text="Пароли остаются в этом сеансе. Назначения кнопок меняются на телефоне." FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/></StackPanel><Button x:Name="ReadButton" Grid.Column="1" Content="Прочитать заново" Click="Read_Click" IsEnabled="False"/><Button x:Name="ApplyButton" Grid.Column="2" Content="Применить к телефону" Margin="10,0,0,0" Style="{StaticResource PrimaryButton}" Click="Apply_Click" IsEnabled="False"/></Grid>
   </Grid>
  </Border>
 </Grid>
</Window>
